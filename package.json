{
  "name": "vegas-lootboxes-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iFrame widgets for the daily Lootboxes cards row (Vegas, Thor) built on one shared core. Vanilla HTML/CSS/JS, no runtime frameworks. Tooling here is optional dev convenience only.",
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "serve:dist": "node scripts/serve.js dist",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm test && npm run test:e2e",
    "convert:webp": "node scripts/convert-webp.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "esbuild": "^0.24.0",
    "sharp": "^0.35.3"
  }
}
